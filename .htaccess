# Hostinger (Apache). Equivale ao vercel.json: HTTPS, domínio sem www,
# redirects das páginas antigas, 404 e cache dos assets.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS e sem www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://casadapizzacaratinga.com.br%{REQUEST_URI} [L,R=301]

  # Arquivos internos que não devem ser servidos (o deploy já exclui a maioria)
  RewriteRule ^(\.git|scripts|data)(/|$) - [R=404,L]
  RewriteRule (^|/)[^/]+\.md$ - [R=404,L]
  RewriteRule ^(package\.json|vercel\.json|\.vercelignore|\.gitignore|\.ftp-deploy-sync-state\.json)$ - [R=404,L]

  # Páginas antigas e index.html
  RewriteRule ^politica-de-privacidade\.html$ /politica-de-privacidade/ [L,R=301]
  RewriteRule ^acessibilidade\.html$ /acessibilidade/ [L,R=301]
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>
